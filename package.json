{
  "name": "opensheeta",
  "version": "0.1.0",
  "description": "Opensheeta — AI agent daemon",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch src/daemon.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:dashboard": "cd dashboard && npm run dev",
    "build": "npm run build:backend && npm run build:frontend && npm run build:dashboard",
    "build:backend": "tsup",
    "build:frontend": "cd frontend && npm run build",
    "build:dashboard": "cd dashboard && npm run build",
    "start": "tsx src/daemon.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mcp:connectors": "tsx mcp-servers/connector-server.ts",
    "mcp:memory": "tsx mcp-servers/memory-server.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "croner": "^3.0.0",
    "hono": "^4.0.0",
    "sql.js": "^1.11.0",
    "tsconfig-paths": "^4.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "concurrently": "^8.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
