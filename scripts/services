#!/bin/bash
# Service management for opensheeta
# Usage: scripts/services {status|start|stop|restart|logs|build} [service_name]

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Service definitions
SERVICES=(opensheeta opensheeta-dash)

# Get repo root (parent of scripts/)
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Service metadata
get_port() {
    case "$1" in
        opensheeta) echo "8765" ;;
        opensheeta-dash) echo "3099" ;;
        *) echo "unknown" ;;
    esac
}

get_plist_path() {
    echo "$REPO_ROOT/scripts/com.neuralj.$1.plist"
}

get_log_path() {
    echo "$REPO_ROOT/logs/$1.log"
}

# Check if plist is loaded
plist_loaded() {
    local label="com.neuralj.$1"
    launchctl list | grep -q "^$label"
}

# Get PID from launchctl
get_pid() {
    local label="com.neuralj.$1"
    launchctl list | grep "^$label" | awk '{print $1}'
}

# Status command
cmd_status() {
    local target="$1"
    local services_to_check=("${SERVICES[@]}")

    if [ -n "$target" ]; then
        services_to_check=("$target")
    fi

    printf "\n%-20s %-10s %-8s %-6s\n" "SERVICE" "STATUS" "PORT" "PID"
    printf "%-20s %-10s %-8s %-6s\n" "-------" "------" "----" "---"

    for svc in "${services_to_check[@]}"; do
        local port=$(get_port "$svc")
        local plist=$(get_plist_path "$svc")

        if [ ! -f "$plist" ]; then
            printf "%-20s ${RED}%-10s${NC} %-8s %-6s\n" "$svc" "missing" "$port" "-"
            continue
        fi

        if plist_loaded "$svc"; then
            local pid=$(get_pid "$svc")
            if [ "$pid" != "-" ] && [ -n "$pid" ]; then
                printf "%-20s ${GREEN}%-10s${NC} %-8s %-6s\n" "$svc" "running" "$port" "$pid"
            else
                printf "%-20s ${YELLOW}%-10s${NC} %-8s %-6s\n" "$svc" "stopped" "$port" "-"
            fi
        else
            printf "%-20s ${RED}%-10s${NC} %-8s %-6s\n" "$svc" "not loaded" "$port" "-"
        fi
    done
    echo ""
}

# Start command
cmd_start() {
    local target="$1"
    local services_to_start=("${SERVICES[@]}")

    if [ -n "$target" ]; then
        services_to_start=("$target")
    fi

    for svc in "${services_to_start[@]}"; do
        local plist=$(get_plist_path "$svc")

        if [ ! -f "$plist" ]; then
            echo -e "${RED}Error: Plist not found for $svc${NC}"
            echo "Expected: $plist"
            continue
        fi

        if plist_loaded "$svc"; then
            echo -e "${YELLOW}$svc is already loaded${NC}"
            continue
        fi

        echo -e "${BLUE}Starting $svc...${NC}"
        mkdir -p "$REPO_ROOT/logs"
        cp "$plist" ~/Library/LaunchAgents/
        launchctl load ~/Library/LaunchAgents/com.neuralj.$svc.plist
        echo -e "${GREEN}$svc started${NC}"
    done
}

# Stop command
cmd_stop() {
    local target="$1"
    local services_to_stop=("${SERVICES[@]}")

    if [ -n "$target" ]; then
        services_to_stop=("$target")
    fi

    for svc in "${services_to_stop[@]}"; do
        if ! plist_loaded "$svc"; then
            echo -e "${YELLOW}$svc is not loaded${NC}"
            continue
        fi

        echo -e "${BLUE}Stopping $svc...${NC}"
        launchctl unload ~/Library/LaunchAgents/com.neuralj.$svc.plist
        rm -f ~/Library/LaunchAgents/com.neuralj.$svc.plist
        echo -e "${GREEN}$svc stopped${NC}"
    done
}

# Restart command
cmd_restart() {
    local target="$1"
    cmd_stop "$target"
    sleep 1
    cmd_start "$target"
}

# Logs command
cmd_logs() {
    local target="$1"

    if [ -z "$target" ]; then
        echo "Usage: scripts/services logs <service_name>"
        echo "Available services: ${SERVICES[*]}"
        exit 1
    fi

    local log=$(get_log_path "$target")

    if [ ! -f "$log" ]; then
        echo -e "${YELLOW}No log file found for $target${NC}"
        echo "Expected: $log"
        exit 1
    fi

    echo -e "${BLUE}Tailing $log...${NC}"
    echo "Press Ctrl+C to stop"
    echo ""
    tail -f "$log"
}

# Build command
cmd_build() {
    local target="$1"

    if [ -z "$target" ]; then
        echo "Usage: scripts/services build <service_name>"
        echo "Available services: daemon dashboard"
        exit 1
    fi

    case "$target" in
        daemon)
            echo -e "${BLUE}Building daemon...${NC}"
            cd "$REPO_ROOT"
            npm run build:backend
            echo -e "${GREEN}Daemon built${NC}"
            ;;
        dashboard)
            echo -e "${BLUE}Building dashboard...${NC}"
            cd "$REPO_ROOT/dashboard"
            npm run build
            echo -e "${GREEN}Dashboard built${NC}"
            ;;
        *)
            echo -e "${RED}Unknown service: $target${NC}"
            echo "Available: daemon, dashboard"
            exit 1
            ;;
    esac
}

# Help
cmd_help() {
    cat << EOF
opensheeta service management

Usage: scripts/services <command> [service_name]

Commands:
  status [name]     Show status of all services (or specific service)
  start [name]      Start services (load launchd plists)
  stop [name]       Stop services (unload launchd plists)
  restart [name]    Restart services
  logs <name>       Tail service logs
  build <name>      Build service (daemon or dashboard)
  help              Show this help

Services:
  opensheeta        Main daemon (port 8765)
  opensheeta-dash   Dashboard UI (port 3099)

Examples:
  scripts/services status
  scripts/services start opensheeta
  scripts/services restart
  scripts/services logs opensheeta
  scripts/services build daemon

EOF
}

# Main
case "${1:-}" in
    status)
        cmd_status "${2:-}"
        ;;
    start)
        cmd_start "${2:-}"
        ;;
    stop)
        cmd_stop "${2:-}"
        ;;
    restart)
        cmd_restart "${2:-}"
        ;;
    logs)
        cmd_logs "${2:-}"
        ;;
    build)
        cmd_build "${2:-}"
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        cmd_help
        exit 1
        ;;
esac
